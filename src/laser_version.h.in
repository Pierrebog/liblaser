 * Compare with LASER_VERSION_CODE(), as with libbluray's version header:
 *
 *     #if LASER_VERSION >= LASER_VERSION_CODE(0, 2, 1)
 *****************************************************************************/

#ifndef LASER_VERSION_H
#define LASER_VERSION_H

#define LASER_VERSION_CODE(major, minor, micro) \
    (((major) * 10000) + ((minor) * 100) + ((micro) * 1))

#define LASER_VERSION_MAJOR  @LASER_VERSION_MAJOR@
#define LASER_VERSION_MINOR  @LASER_VERSION_MINOR@
#define LASER_VERSION_MICRO  @LASER_VERSION_MICRO@

#define LASER_VERSION_STRING "@LASER_VERSION_MAJOR@.@LASER_VERSION_MINOR@.@LASER_VERSION_MICRO@"

#define LASER_VERSION \
    LASER_VERSION_CODE(LASER_VERSION_MAJOR, LASER_VERSION_MINOR, LASER_VERSION_MICRO)

#endif /* LASER_VERSION_H */
